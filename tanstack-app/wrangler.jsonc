{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "propertybikri",
  "main": "./src/server/worker.ts",
  "compatibility_date": "2026-08-10",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "html_handling": "none",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "propertybikri-prod-db",
      "database_id": "e4ed52f1-5d03-486e-9be8-4b6b0964a318",
      "migrations_dir": "migrations"
    }
  ],
  "routes": [
    { "pattern": "propertybikri.com/*", "zone_name": "propertybikri.com" },
    { "pattern": "www.propertybikri.com/*", "zone_name": "propertybikri.com" },
    { "pattern": "api.propertybikri.com/*", "zone_name": "propertybikri.com" }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "RELEASE_ID": "2026.08.14.3",
    "PUBLIC_APP_URL": "https://propertybikri.com",
    "PUBLIC_API_URL": "https://propertybikri.com/api",
    "PUBLIC_DEFAULT_CONTACT_PHONE": "+8801700000000",
    "PUBLIC_WHATSAPP_NUMBER": "+8801700000000",
    "JWT_ISSUER": "propertybikri.com",
    "JWT_AUDIENCE": "propertybikri.com"
  }
}
