{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "propertybikri-worker",
  "main": "./src/server/worker.ts",
  "compatibility_date": "2026-08-10",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "propertybikri-db",
      "database_id": "local-d1-preview-id",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PROPERTY_IMAGES",
      "bucket_name": "propertybikri-images"
    }
  ],
  "vars": {
    "ENVIRONMENT": "local",
    "RELEASE_ID": "2026.08.10.1",
    "PUBLIC_APP_URL": "http://localhost:3010",
    "PUBLIC_API_URL": "http://localhost:3010/api",
    "PUBLIC_DEFAULT_CONTACT_PHONE": "+8801700000000",
    "PUBLIC_WHATSAPP_NUMBER": "+8801700000000",
    "JWT_ISSUER": "propertybikri.com",
    "JWT_AUDIENCE": "propertybikri.com"
  },
  "env": {
    "preview": {
      "name": "propertybikri-worker-preview",
      "vars": {
        "ENVIRONMENT": "preview",
        "PUBLIC_APP_URL": "https://preview.propertybikri.com",
        "PUBLIC_API_URL": "https://preview.propertybikri.com/api"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "propertybikri-preview-db",
          "database_id": "preview-d1-id",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "PROPERTY_IMAGES",
          "bucket_name": "propertybikri-preview-images"
        }
      ]
    },
    "production": {
      "name": "propertybikri-worker-production",
      "vars": {
        "ENVIRONMENT": "production",
        "PUBLIC_APP_URL": "https://propertybikri.com",
        "PUBLIC_API_URL": "https://api.propertybikri.com"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "propertybikri-prod-db",
          "database_id": "prod-d1-id",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "PROPERTY_IMAGES",
          "bucket_name": "propertybikri-prod-images"
        }
      ]
    }
  }
}
